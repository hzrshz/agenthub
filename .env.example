# ============================================================
# AgentHub 运行配置模板
#
# 用法：
#   1. 复制为 .env（已 git 忽略）：cp .env.example .env
#   2. 按需修改；唯一必填是 HUB_PUBLIC_URL
#   3. 启动：./scripts/run.sh serve
#      （或容器场景：docker run --env-file .env ...，无需 run.sh）
#
# 安全约定（等保红线）：
#   - 数据库口令、管理员口令一律不写本文件：
#       数据库口令 → 由 ./scripts/run.sh init 写入 HUB_DB_PASSWORD_FILE 指向的
#                    独立文件（0600），启动时自动校验存在与权限；
#       管理员口令 → 交互式 `agenthub admin init/reset`，终端不回显。
#   - 本文件只放"非秘密"配置；DSN 里带口令形态会被程序启动校验直接拒绝。
# ============================================================

# ---- 必填 ----
# hub 对外地址。生产必须 https://；测试允许 http://localhost 或 http://<局域网IP>。
# 反代子路径部署可带一段 base path（如 https://hub.example.com/app）。
HUB_PUBLIC_URL=https://hub.example.com

# ---- 可选（不设置即用默认值）----
# 监听地址（容器内为 0.0.0.0:8787）。
#HUB_LISTEN=127.0.0.1:8787

# 数据目录：SQLite 控制库文件与秘密文件的根目录，默认 ~/.agenthub（容器内 /data）。
#HUB_DATA_DIR=/var/lib/agenthub

# 可信反代网段（逗号分隔 CIDR）。用了反向代理就应设置：只有来自这些网段的
# 请求才采信 X-Forwarded-For，用于按 IP 限流；宿主机反代填 127.0.0.1/32,::1/128。
#HUB_TRUSTED_PROXY_CIDRS=127.0.0.1/32

# ---- 控制库后端（默认 sqlite 单文件，以下不配置即用默认）----
# 后端类型：sqlite | mysql（8.0.19+ 协议兼容） | postgres（14+ 协议兼容）。
#HUB_DB_DRIVER=mysql

# 仅 mysql/postgres：不含口令的连接串（口令绝不写在这里）。
#   mysql     : user@tcp(host:3306)/dbname
#   postgres  : host=host port=5432 user=user dbname=dbname
# 注意：DSN 里的库/账号须已由运维在数据库中创建好。
# 等保要求数据库链路加密，生产推荐带 TLS 参数：
#   mysql     : user@tcp(host:3306)/dbname?tls=preferred（或 tls=require）
#   postgres  : host=host port=5432 user=user dbname=dbname sslmode=require
#HUB_DB_DSN=user@tcp(127.0.0.1:3306)/agenthub

# 仅 mysql/postgres：数据库口令文件（init 创建，0600）。
# 推荐放在数据目录的 secrets/ 下，如 $HUB_DATA_DIR/secrets/db-pass（写实际路径）。
# 也可用 docker secret 挂载的 /run/secrets/db-pass（权限由部署侧保证）。
#HUB_DB_PASSWORD_FILE=/var/lib/agenthub/secrets/db-pass

# 仅 mysql/postgres：连接池上限，默认 10（sqlite 固定 2，不受此配置影响）。
#HUB_DB_MAX_OPEN_CONNS=10